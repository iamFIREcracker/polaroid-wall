# See https://help.github.com/ignore-files/ for more about ignoring files.

# dependencies
/node_modules
/e2e/node_modules

# end-to-end tests: generated fixture pictures and the config listing them
/e2e/.tmp

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local content: symlinks into Dropbox (the Docker image serves these from
# /storage instead, see nginx.conf)
/public/config.js
/public/images

# output of the Maven packaging experiment (pom.xml)
/target

# redesign exploration: screenshots and reports (the code lives on the
# redesign/* branches)
/redesigns

# throwaway git worktrees created by agent workflows
/.claude/worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
